# CFP War Chest — environment variables
#
# Local dev:  copy this file to .env.local and fill in real values.
#             .env.local is gitignored (.gitignore rule ".env*") — NEVER commit real values.
# Vercel:     set the same keys in Project → Settings → Environment Variables.
#
# Get Supabase values from: Supabase Dashboard → Project Settings → API.

# ── Required — the app cannot boot without these ────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key      # client-exposed, safe
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key          # SERVER-ONLY SECRET — never expose to the browser

# ── Required for a fully functional league ──────────────────────────────────
RESEND_API_KEY=your-resend-api-key                              # invites / on-clock / standings emails (resend.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000                       # set to your production URL on Vercel, or email links point to localhost
BOOTSTRAP_ADMIN_EMAIL=you@example.com                           # used once by POST /api/auth/bootstrap to create the first admin

# ── Optional — safe code defaults exist ─────────────────────────────────────
# EMAIL_FROM="War Chest <noreply@yourdomain.com>"              # default: "CFB War Chest <noreply@cfbwarchest.com>"
# BOOTSTRAP_ADMIN_NAME=Commissioner                            # default: "Commissioner"

# ── Not consumed by the app runtime (do NOT rely on these) ──────────────────
# SENTRY_DSN=...            # @sentry/nextjs is installed but NOT wired up yet — setting this has no effect
# PLAYWRIGHT_BASE_URL=...   # E2E test tooling only — do NOT set this in Vercel
