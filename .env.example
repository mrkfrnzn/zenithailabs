# ─────────────────────────────────────────────────────────────
# NFL Fantasy Playoff Survivor League — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────

# ── Backend Server ────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Database ─────────────────────────────────────────────────
# SQLite file path (relative to project root)
DATABASE_PATH=./data/survivor.db

# ── Frontend ──────────────────────────────────────────────────
# URL where the React dev server or production build is served
APP_URL=http://localhost:3000
# CRA: prefix with REACT_APP_
REACT_APP_API_URL=http://localhost:3001

# ── Auth / JWT ────────────────────────────────────────────────
# Change this to a long random secret in production!
JWT_SECRET=change_me_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d
MAGIC_LINK_EXPIRES_MINUTES=30

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── Email (Magic Link Delivery) ───────────────────────────────
# Leave blank in dev — the magic link will be printed to the server console.
# Fill in to send real emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourdomain.com

# ── NFL Stats API ─────────────────────────────────────────────
# Set to 'mock' during development (uses seeded SQLite data).
# Change to your provider key to use a real data source.
#
# Supported values (add your own in backend/services/nflApi/adapter.js):
#   mock        — seeded local data (default, no API key needed)
#   sportsdata  — SportsData.io (TODO: implement sportsDataProvider.js)
#   sleeper     — Sleeper API    (TODO: implement sleeperProvider.js)
#   apisports   — API-Sports     (TODO: implement apiSportsProvider.js)
NFL_API_PROVIDER=mock
#
# Your API key for the chosen provider (if not 'mock')
NFL_API_KEY=
#
# Optional: base URL override for self-hosted or sandbox endpoints
NFL_API_BASE_URL=
